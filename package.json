{
  "name": "dsh-ask-graph",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "license": "UNLICENSED",
  "description": "提问图谱：把 DSH 会话历史整理成可下钻的专题图与对话节点图",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonyischen/ds_ask_graph.git"
  },
  "homepage": "https://github.com/tonyischen/ds_ask_graph#readme",
  "bugs": {
    "url": "https://github.com/tonyischen/ds_ask_graph/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sessions",
    "graph",
    "knowledge-base"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "dist/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "@xyflow/react": "^12.8.6",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "9.0.1",
    "remark-gfm": "4.0.0"
  }
}
